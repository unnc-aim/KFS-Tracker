<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
            schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>kfs_tracker</name>
  <version>0.1.0</version>
  <description>KFS keypoint tracker (LibTorch) as a ROS 2 node: local camera (opencv/realsense/file)
    or ROS image topic (Image/CompressedImage, optional depth) input; publishes annotated image and
    KFSDetection result.</description>
  <maintainer email="admin@uonaim.tech">UNNC-AIM</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- 自定义消息：定义与运行时支持 -->
  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <!-- ROS 运行期依赖（libtorch/OpenCV/realsense2 为系统外部库，通过 CMake find_package 引入，不在此声明） -->
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>message_filters</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
